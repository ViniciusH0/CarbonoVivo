  m_EditorClassIdentifier: Assembly-CSharp::BiodiversityManager
  speciesCatalog:
  - id: guapuruvu
    commonName: Guapuruvu
    scientificName: Schizolobium parahyba
    ecologicalRole: "\xC1rvore pioneira de r\xE1pido crescimento que recupera a sombra e umidade do solo."
    gameplayEffect: "+50% na velocidade de crescimento e acelera a regenera\xE7\xE3o da sa\xFAde florestal."
    costInPpm: 25
    isUnlocked: 0
    level: 0
  - id: araucaria
    commonName: "Arauc\xE1ria"
    scientificName: Araucaria angustifolia
    ecologicalRole: "Gigante da floresta com grande capacidade de absor\xE7\xE3o e reten\xE7\xE3o h\xEDdrica."
    gameplayEffect: "Amplia a reten\xE7\xE3o h\xEDdrica do bioma em +40% e dobra o sequestro de carbono por \xE1rvore."
    costInPpm: 60
    isUnlocked: 0
    level: 0
  - id: gralha_mico
    commonName: "Gralha-azul & Mico-le\xE3o-dourado"
    scientificName: Cyanocorax caeruleus & Leontopithecus rosalia
    ecologicalRole: "Mestres da dispers\xE3o zool\xF3gica de sementes nativas por toda a floresta."
    gameplayEffect: "Dispers\xE3o autom\xE1tica: brota uma nova \xE1rvore nativa a cada 16 segundos sem gastar CO2."
    costInPpm: 100
    isUnlocked: 0
    level: 0
  - id: besouro_rola_bosta
    commonName: Besouro Rola-Bosta
    scientificName: Canthon sp. (Scarabaeinae)
    ecologicalRole: "Engenheiro ecol\xF3gico do solo, recicla mat\xE9ria org\xE2nica e cria galerias de aera\xE7\xE3o."
    gameplayEffect: "Aumenta os \xEDndices de fertilidade e permeabilidade do solo (+35% sequestro geral)."
    costInPpm: 75
    isUnlocked: 0
    level: 0
  - id: tamandua_mirim
    commonName: "Tamandu\xE1-mirim"
    scientificName: Tamandua tetradactyla
    ecologicalRole: "Predador natural que atua no controle biol\xF3gico de pragas e prote\xE7\xE3o de mudas."
    gameplayEffect: "Controle biol\xF3gico: reduz invas\xF5es e tem 50% de chance de expulsar lenhadores automaticamente."
    costInPpm: 120
    isUnlocked: 0
    level: 0
  seedDispersalInterval: 16
