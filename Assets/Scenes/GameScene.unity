  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Parab\xE9ns!\n\nVoc\xEA conseguiu capturar 1000 toneladas de carbono da atmosfera e restaurar o equil\xEDbrio da regi\xE3o.\n\nContra todas as probabilidades, a floresta voltou a crescer, os rios voltaram a fluir e a comunidade encontrou esperan\xE7a em meio \xE0s ru\xEDnas do velho mundo.\n\nSeu experimento provou que a recupera\xE7\xE3o ainda \xE9 poss\xEDvel.\n\nA floresta est\xE1 viva. O futuro tamb\xE9m. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e0a0aa208f1afb6449549779c2ea5b87, type: 2}
